# Токен бота от @BotFather (обязательно для Telegram-части)
BOT_TOKEN=
# Публичный адрес сайта. На Render подставляется автоматически (RENDER_EXTERNAL_URL).
PUBLIC_URL=
# Секрет для подписи веб-сессий (любая длинная случайная строка)
SESSION_SECRET=
# Путь к базе SQLite (на Render с диском: /var/data/database.db)
DATABASE_PATH=./data/database.db
PORT=3000
